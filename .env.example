# Backend
SUPABASE_URL=
# service_role secret key (required, bypasses RLS; backend enforces org scoping itself)
SUPABASE_SERVICE_KEY=
# anon/publishable key (required, used to verify user JWTs and call RPCs as the user)
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
BREVO_API_KEY=
SENDER_EMAIL=noreply@kairos.com
SENDER_NAME=Kairos CRM
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
GOOGLE_API_KEY=
RENDER_API_KEY=

# Security
# Generate with: openssl rand -hex 32
KAIROS_API_TOKEN=
# Optional comma-separated origins for production, e.g. https://kairos.vercel.app,https://kairosdis.com.ar
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
